# Controls what is uploaded to Cloud Build when running `gcloud run deploy --source .`
# Keep: requirements.txt, challenge/*.py, data/ (the image COPYs these).
.git/
.github/
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
reports/
htmlcov/
.coverage
coverage.xml
tests/
docs/
*.ipynb
.vscode/
.idea/
*.md
